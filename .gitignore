lerna-debug.log*

# Ignore environment files
.env
.env.*

# Ignore editor folders
.vscode/
.idea/
.DS_Store
*.sw?

# Ignore package output
*.nupkg
*.snupkg

# Ignore OS generated files
Thumbs.db
Desktop.ini
