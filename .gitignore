# Ignore build output and user-specific files for .NET and Node.js projects
bin/
obj/
*.user
*.suo
*.userosscache
*.sln.docstates

# Ignore node_modules and logs
node_modules/
dist/
logs/
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
